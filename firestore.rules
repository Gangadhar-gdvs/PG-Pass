rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Mirrors lib/constants/status.ts and limits.ts — keep in sync (§3.4).
    function isSignedIn() { return request.auth != null; }
    function notSuspended() { return isSignedIn() && (!('suspended' in request.auth.token) || request.auth.token.suspended != true); }
    function isAdmin() { return notSuspended() && ('admin' in request.auth.token && request.auth.token.admin == true); }
    function isOwnerUid(ownerId) { return notSuspended() && request.auth.uid == ownerId; }
    function isStaffFor(ownerId) {
      return notSuspended()
        && ('role' in request.auth.token && request.auth.token.role == 'staff')
        && ('ownerId' in request.auth.token && request.auth.token.ownerId == ownerId);
    }
    function boundedList() { return request.query.limit <= 100; } // MAX_LIST_LIMIT

    // Staff = claims say so (free) AND the live staff/{uid} doc agrees: it exists,
    // belongs to this owner and is active. Reading the doc (1 billed read per
    // request; repeated get()s of the same doc count once) makes suspension /
    // revocation effective immediately instead of at the next ID-token refresh.
    // Mirrors withAuth (accountStatus absent => 'active').
    function staffProfile() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)).data; }
    function isActiveStaffFor(ownerId) {
      return isStaffFor(ownerId)
        && staffProfile().ownerId == ownerId
        && staffProfile().get('accountStatus', 'active') == 'active';
    }
    // ...and holds at least one of `perms` (STAFF_PERMISSIONS values from
    // lib/constants/permissions.ts; tests/rules/coverage.test.ts checks the names).
    function isStaffWith(ownerId, perms) {
      return isActiveStaffFor(ownerId) && staffProfile().get('permissions', []).hasAny(perms);
    }
    // Owner / admin first (claims only, no document read), staff last.
    function canReadOwnerScope(ownerId) { return isOwnerUid(ownerId) || isAdmin() || isActiveStaffFor(ownerId); }
    function canReadOwnerScopeWith(ownerId, perms) { return isOwnerUid(ownerId) || isAdmin() || isStaffWith(ownerId, perms); }

    // Staff permission sets per data class.
    function tenancyPerms() { return ['manage_tenants', 'collect_rent']; } // residents, rent, deposits
    function photoPerms()   { return ['manage_tenants', 'manage_photos']; }
    function moneyPerms()   { return ['manage_expenses']; }                 // expenses, utility bills

    match /owners/{ownerId} {
      allow get:   if isOwnerUid(ownerId) || isAdmin() || isActiveStaffFor(ownerId);
      allow list:  if isAdmin() && boundedList();
      allow write: if false;
    }

    match /staff/{staffUid} {
      // Staff lists are served strictly via GET /api/staff (Admin SDK) to avoid client query-filter failures.
      allow get:   if notSuspended() && (request.auth.uid == staffUid || isOwnerUid(resource.data.ownerId) || isAdmin());
      allow list:  if false;
      allow write: if false;
    }

    match /beds/{bedId} {
      allow get:   if canReadOwnerScope(resource.data.ownerId);
      allow list:  if canReadOwnerScope(resource.data.ownerId) && boundedList();
      allow write: if false;
    }

    // Residents (incl. phone + raw pass token), rent and deposits: staff need a
    // tenancy permission (manage_tenants or collect_rent).
    match /tenants/{tenantId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms());
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms()) && boundedList();
      allow write: if false;
    }

    match /deposits/{txId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms());
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms()) && boundedList();
      allow write: if false;
    }

    match /rent_records/{recordId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms());
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, tenancyPerms()) && boundedList();
      allow write: if false; // transitions happen strictly in rent.service.ts (§10.1)
    }

    match /movein_photos/{photoId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, photoPerms()); // metadata only; image bytes come from B2 via /api (§11)
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, photoPerms()) && boundedList();
      allow write: if false;
    }

    match /subscription_requests/{reqId} {
      allow get:   if isOwnerUid(resource.data.ownerId) || isAdmin();
      allow list:  if (isOwnerUid(resource.data.ownerId) || isAdmin()) && boundedList();
      allow write: if false;
    }

    match /maintenance_tickets/{ticketId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, ['manage_maintenance']);
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, ['manage_maintenance']) && boundedList();
      allow write: if false; // created by tenant via /api/maintenance, resolved via Admin SDK
    }

    // Owner-targeted alerts (subscription, payment, move-out). No client reads
    // them; owner + admin only (no staff permission maps to billing alerts).
    match /owner_notifications/{id} {
      allow get:   if isOwnerUid(resource.data.ownerId) || isAdmin();
      allow list:  if (isOwnerUid(resource.data.ownerId) || isAdmin()) && boundedList();
      allow write: if false;
    }

    // Notices are served through app/api (owner publishes, residents/staff read
    // via their viewer routes), so no direct client access is needed.
    match /notices/{noticeId} {
      allow read, write: if false;
    }

    // Staff tasks — served via app/api (owner assigns, staff complete).
    match /staff_tasks/{taskId} {
      allow read, write: if false;
    }

    // Visitor log — served via app/api (owner/staff record at the gate).
    match /visitors/{visitorId} {
      allow read, write: if false;
    }

    match /expenses/{expenseId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, moneyPerms());
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, moneyPerms()) && boundedList();
      allow write: if false; // created/deleted via /api/expenses (Admin SDK)
    }

    // Utility bills + their frozen per-resident allocation. Owner (and staff
    // with manage_expenses) may read; create/apply/void only via /api/utilities.
    match /utility_bills/{billId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, moneyPerms());
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, moneyPerms()) && boundedList();
      allow write: if false;
    }

    // Room inventory / assets (with append-only history). Writes via /api/assets.
    match /assets/{assetId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, ['manage_beds']);
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, ['manage_beds']) && boundedList();
      allow write: if false;
    }

    match /guest_stays/{stayId} {
      allow get:   if canReadOwnerScopeWith(resource.data.ownerId, ['manage_guests']);
      allow list:  if canReadOwnerScopeWith(resource.data.ownerId, ['manage_guests']) && boundedList();
      allow write: if false; // check-in/checkout via /api/guests (Admin SDK)
    }

    match /properties/{propertyId} {
      allow get:   if canReadOwnerScope(resource.data.ownerId);
      allow list:  if canReadOwnerScope(resource.data.ownerId) && boundedList();
      allow write: if false; // managed via /api/properties (Admin SDK)
    }

    // PG gallery photos + public PG reviews are served ONLY through app/api as
    // DTOs (discovery/reviews services drop hidden reviews and reviews of PGs
    // with the feature disabled, and never return reviewerUid/uploadedBy/
    // ownerId). No client SDK code reads them, so direct access is denied.
    match /property_photos/{photoId} {
      allow read, write: if false;
    }

    match /pg_reviews/{reviewId} {
      allow read, write: if false;
    }

    // Individual staff ratings (resident → staff). Read by the owning PG + admin;
    // written server-side via /api/reviews/staff.
    match /staff_ratings/{ratingId} {
      allow get:   if canReadOwnerScope(resource.data.ownerId);
      allow list:  if canReadOwnerScope(resource.data.ownerId) && boundedList();
      allow write: if false;
    }

    // Owner↔admin support chat. Owner reads ONLY their own thread + messages
    // (enables live onSnapshot); admin reads all. Writes are server-only.
    match /support_threads/{ownerId} {
      allow get:   if isOwnerUid(ownerId) || isAdmin();
      allow list:  if isAdmin() && boundedList();
      allow write: if false;

      match /messages/{msgId} {
        allow get:   if isOwnerUid(ownerId) || isAdmin();
        allow list:  if (isOwnerUid(ownerId) || isAdmin()) && boundedList();
        allow write: if false;
      }
    }

    // Resident self-service accounts. A resident reads only their own profile;
    // all discovery/join data is served via the Admin SDK through /api/**.
    match /residents/{uid} {
      allow get:   if notSuspended() && request.auth.uid == uid;
      allow list, write: if false;
    }

    // Join requests are read/written server-side only (owner sees them via API,
    // resident creates them via API). No direct client access.
    match /join_requests/{id} {
      allow read, write: if false;
    }

    // Single-doc reads have no query limit, so get and list are separate rules.
    match /audit_logs/{logId}           { allow get: if isAdmin(); allow list: if isAdmin() && boundedList(); allow write: if false; }
    match /admin_notifications/{id}     { allow get: if isAdmin(); allow list: if isAdmin() && boundedList(); allow write: if false; }
    match /support_flags/{flagId}       { allow get: if isAdmin(); allow list: if isAdmin() && boundedList(); allow write: if false; }
    match /metrics/{date}               { allow get: if isAdmin(); allow list, write: if false; }

    // Admin roster (who is an admin + their permissions). Read/written only via
    // the Admin SDK (super-admin-gated API). Never exposed to any client.
    match /admin_users/{adminUid}       { allow read, write: if false; }

    // Strictly server-only internal collections
    match /portal_tokens/{token}        { allow read, write: if false; }
    match /portal_lockouts/{token}      { allow read, write: if false; }
    match /utr_claims/{claimId}         { allow read, write: if false; }
    match /rate_limits/{key}            { allow read, write: if false; }
    match /idempotency_keys/{key}       { allow read, write: if false; }

    match /{document=**}                { allow read, write: if false; }
  }
}
