# Template for .env.staging
NEXT_PUBLIC_APP_NAME="PGPass (Staging)"
NEXT_PUBLIC_APP_URL="https://staging.pgpass.in"
NEXT_PUBLIC_USE_EMULATORS="false"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC-staging-api-key-here"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pg-pass-staging.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pg-pass-staging"
NEXT_PUBLIC_FIREBASE_APP_ID="1:423356141939:web:staging-app-id"
NEXT_PUBLIC_SAAS_UPI_ID="staging-pgpass@upi"
NEXT_PUBLIC_SAAS_UPI_NAME="PG-Pass Staging"
# Support contact shown to residents/owners (change freely)
NEXT_PUBLIC_SUPPORT_EMAIL="vektorsynapse@gmail.com"
APP_ALLOWED_ORIGINS="https://staging.pgpass.in"
FIREBASE_ADMIN_CREDENTIALS_B64=""
B2_ENDPOINT="https://s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_S3_HOST="s3.us-west-004.backblazeb2.com"
STORAGE_FORCE_PATH_STYLE="false"
B2_BUCKET="pgpass-media-staging"
B2_KEY_ID="staging-b2-key-id"
B2_APP_KEY="staging-b2-app-key"
# Optional off-site encrypted backups (separate bucket + key). Leave unset to
# disable. BACKUP_ENCRYPTION_KEY must be a 32-byte base64 key.
B2_BACKUP_BUCKET=""
B2_BACKUP_KEY_ID=""
B2_BACKUP_APP_KEY=""
BACKUP_ENCRYPTION_KEY=""
CRON_SECRET="staging-cron-secret-change-me"
LOG_LEVEL="info"
# Optional transactional email (Resend). Unset = email disabled.
RESEND_API_KEY=""
EMAIL_FROM="PGPass Staging <noreply@staging.pgpass.in>"
# Optional transactional SMS (generic HTTP provider). Unset = SMS disabled.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PGPASS"

# Separate admin URL (optional). Set ONLY on the admin deployment to the host
# that serves the admin console — e.g. "staging-admin.pgpass.in" or
# "pgpass-admin-stage.vercel.app". When set:
#   - requests to that host open the admin console at its root (no /admin path shown)
#   - the /admin path is blocked on the main host
# Leave UNSET for local dev / a single combined deployment (admin stays at /admin).
ADMIN_HOST=""

# Owner "send rent reminders from my own Gmail" (optional). Create an OAuth
# client in Google Cloud (type: Web), enable the Gmail API, add redirect URI
# https://YOUR_APP_URL/api/owners/gmail/callback, then set these. Unset = feature
# hidden and reminders fall back to the free WhatsApp flow.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# 32+ char secret (hashed to a 32-byte AES key) encrypting stored refresh tokens.
# Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=""
