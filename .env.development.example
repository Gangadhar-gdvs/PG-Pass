# Template for .env.development
NEXT_PUBLIC_APP_NAME="PGPass (Local Dev)"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_EMULATORS="true"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC-Dev-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pgpass-demo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pgpass-demo"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"
NEXT_PUBLIC_SAAS_UPI_ID="dev-billing@upi"
NEXT_PUBLIC_SAAS_UPI_NAME="PG-Pass Dev Billing"
# Support contact shown to residents/owners (change freely)
NEXT_PUBLIC_SUPPORT_EMAIL="vektorsynapse@gmail.com"
APP_ALLOWED_ORIGINS="http://localhost:3000"
# With emulators the Admin SDK auto-connects; leave blank locally. For a real
# dev Firebase project, set a base64-encoded service-account JSON.
FIREBASE_ADMIN_CREDENTIALS_B64=""
B2_ENDPOINT="http://localhost:9000"
B2_REGION="eu-central-003"
B2_S3_HOST="localhost:9000"
STORAGE_FORCE_PATH_STYLE="true"
B2_BUCKET="pgpass-photos"
B2_KEY_ID="minioadmin"
B2_APP_KEY="minioadmin"
# Optional off-site encrypted backups — unused in local dev.
B2_BACKUP_BUCKET=""
B2_BACKUP_KEY_ID=""
B2_BACKUP_APP_KEY=""
BACKUP_ENCRYPTION_KEY=""
CRON_SECRET="dev-cron-secret-12345"
LOG_LEVEL="debug"
# Optional transactional email (Resend). Unset = email is a silent no-op.
RESEND_API_KEY=""
EMAIL_FROM="PGPass Dev <noreply@localhost>"
# Optional transactional SMS (generic HTTP provider). Unset = SMS disabled and
# reminders fall back to the free "open WhatsApp" flow.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PGPASS"
