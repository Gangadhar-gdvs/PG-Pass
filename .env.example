# ====================================================================
# PG-PASS MASTER ENVIRONMENT TEMPLATE (.env.example)
# All variables validated at runtime by lib/env.ts using Zod
# ====================================================================

# 1. PUBLIC WEB CONFIG (Exposed to browser)
NEXT_PUBLIC_APP_NAME="PGPass"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set "true" for local emulator suite, "false" for live cloud
NEXT_PUBLIC_USE_EMULATORS="false"

# Firebase Client Web SDK Config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# SaaS Platform Subscription Payment (displayed in /billing)
NEXT_PUBLIC_SAAS_UPI_ID=""
NEXT_PUBLIC_SAAS_UPI_NAME="Platform (PG-Pass)"

# Support contact shown to residents/owners
NEXT_PUBLIC_SUPPORT_EMAIL="vektorsynapse@gmail.com"

# 2. SERVER-ONLY CONFIG (Never exposed to browser bundle)
# Comma-separated list of allowed origins for state-changing requests and CORS
APP_ALLOWED_ORIGINS="http://localhost:3000"

# Firebase Admin SDK Base64 Service Account JSON (`cat service-account.json | base64 -w 0`)
FIREBASE_ADMIN_CREDENTIALS_B64=""

# Backblaze B2 S3 Storage (or local MinIO on http://localhost:9000)
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_S3_HOST="s3.eu-central-003.backblazeb2.com"
STORAGE_FORCE_PATH_STYLE="false"
B2_BUCKET=""
B2_KEY_ID=""
B2_APP_KEY=""

# Optional off-site encrypted backups (separate bucket + key)
B2_BACKUP_BUCKET=""
B2_BACKUP_KEY_ID=""
B2_BACKUP_APP_KEY=""
BACKUP_ENCRYPTION_KEY=""

# Cron & System Security Secrets
CRON_SECRET=""
LOG_LEVEL="info"

# Optional transactional email (Resend free tier). Unset = email disabled
RESEND_API_KEY=""
EMAIL_FROM="PGPass <noreply@pgpass.in>"

# Optional transactional SMS (generic HTTP provider). Unset = SMS disabled
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PGPASS"
