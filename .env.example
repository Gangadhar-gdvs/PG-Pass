# ====================================================================
# PG-PASS CENTRAL ENVIRONMENT CONFIGURATION (Rev 3 Final)
# Copy this file to .env.local and fill in values for your environment.
# ====================================================================

# 1. PUBLIC WEB CONFIG (Exposed to client bundle)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_USE_EMULATORS="true"

# Firebase Web Client SDK Config (from Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY="demo-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pgpass-demo.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pgpass-demo"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef"

# SaaS Platform Subscription Payment (displayed in /billing)
NEXT_PUBLIC_SAAS_UPI_ID="pgpass@upi"
NEXT_PUBLIC_SAAS_UPI_NAME="PG-Pass Platform"

# 2. SERVER-ONLY CONFIG (Never exposed to browser bundle)
# Allowed origins for CORS and state-changing requests
APP_ALLOWED_ORIGINS="http://localhost:3000"

# Firebase Admin SDK Base64 Service Account JSON (omit in emulator mode)
# FIREBASE_ADMIN_CREDENTIALS_B64=""

# Backblaze B2 S3 Storage (MinIO locally in development)
B2_ENDPOINT="http://localhost:9000"
B2_REGION="eu-central-003"
B2_S3_HOST="localhost:9000"
STORAGE_FORCE_PATH_STYLE="true"
B2_BUCKET="pgpass-photos"
B2_KEY_ID="minioadmin"
B2_APP_KEY="minioadmin"

# Backblaze B2 Backup Bucket (Optional / Post-pilot)
# B2_BACKUP_BUCKET="pgpass-backups"
# B2_BACKUP_KEY_ID=""
# B2_BACKUP_APP_KEY=""
# BACKUP_ENCRYPTION_KEY=""

# Cron & Internal Security Secrets
CRON_SECRET="dev-cron-secret-change-in-production"
LOG_LEVEL="info"
