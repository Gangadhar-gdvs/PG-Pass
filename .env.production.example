# Template for .env.production
NEXT_PUBLIC_APP_NAME="PGPass"
NEXT_PUBLIC_APP_URL="https://pgpass.in"
NEXT_PUBLIC_USE_EMULATORS="false"
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyC-prod-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="pg-pass.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="pg-pass"
NEXT_PUBLIC_FIREBASE_APP_ID="1:423356141939:web:prod-app-id"
NEXT_PUBLIC_SAAS_UPI_ID="pgpass@upi"
NEXT_PUBLIC_SAAS_UPI_NAME="PG-Pass Platform"
# Support contact shown to residents/owners (change freely)
NEXT_PUBLIC_SUPPORT_EMAIL="vektorsynapse@gmail.com"
APP_ALLOWED_ORIGINS="https://pgpass.in,https://www.pgpass.in"
FIREBASE_ADMIN_CREDENTIALS_B64=""
# B2 region MUST match the region your bucket actually lives in (shown in the
# Backblaze console). All three values below use the same region string. Browser
# photo uploads PUT directly to this endpoint, so the bucket ALSO needs a CORS
# rule allowing s3_put/s3_get from APP_ALLOWED_ORIGINS — see docs/B2-CORS-SETUP.md.
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"
B2_REGION="eu-central-003"
B2_S3_HOST="s3.eu-central-003.backblazeb2.com"
STORAGE_FORCE_PATH_STYLE="false"
B2_BUCKET="pgpass-media-prod"
B2_KEY_ID="prod-b2-application-key-id"
B2_APP_KEY="prod-b2-application-key-secret"
# Optional off-site encrypted backups (separate bucket + key). Leave unset to
# disable automated backups. BACKUP_ENCRYPTION_KEY must be a 32-byte base64 key.
B2_BACKUP_BUCKET=""
B2_BACKUP_KEY_ID=""
B2_BACKUP_APP_KEY=""
BACKUP_ENCRYPTION_KEY=""
CRON_SECRET="prod-cron-secret-must-be-secure-64char-hex"
LOG_LEVEL="info"
# Optional transactional email (Resend free tier). Leave unset to disable email
# entirely — the app stays card-free and simply skips sending.
RESEND_API_KEY=""
EMAIL_FROM="PGPass <noreply@pgpass.in>"
# Optional transactional SMS (generic HTTP provider). Leave unset to keep the
# free "open WhatsApp" reminder flow and skip SMS entirely.
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID="PGPASS"

# Separate admin URL (optional). Set ONLY on the admin deployment to the host
# that serves the admin console — e.g. "pgpass-admin.vercel.app" now, or
# "admin.yourdomain.com" once you have a custom domain. When set:
#   - requests to that host open the admin console at its root (no /admin path shown)
#   - the /admin path is blocked on the main host
# Leave UNSET for local dev / a single combined deployment (admin stays at /admin).
ADMIN_HOST=""

# Owner "send rent reminders from my own Gmail" (optional, free). Create an OAuth
# client in Google Cloud Console (type: Web), add redirect URI
# https://YOUR_APP_URL/api/owners/gmail/callback, enable the Gmail API, and set:
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Any 32+ char secret (hashed to a 32-byte AES key) encrypting stored refresh
# tokens. Generate: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=""
